{
  "name": "cooklikehoc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "像老乡鸡那样做饭（Fork）- 基于《老乡鸡菜品溯源报告》整理的菜谱，含手绘流程图",
  "author": "AlexanderJ-Carter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderJ-Carter/CookLikeHOC.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prebuild:indexes": "node ./.vitepress/scripts/generate-indexes.mjs",
    "docs:dev": "npm run prebuild:indexes && vitepress dev .",
    "docs:build": "npm run prebuild:indexes && vitepress build .",
    "docs:preview": "vitepress preview .",
    "build": "npm run docs:build",
    "start": "npm run docs:dev",
    "docker:build": "docker build -t cooklikehoc:latest .",
    "docker:run": "docker run -d -p 8080:80 cooklikehoc:latest"
  },
  "devDependencies": {
    "vitepress": "^1.6.0"
  }
}